{
  "name": "copilot-multi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-instance manager for the GitHub Copilot CLI — branch-per-session, rich UI, lossless rendering.",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "node --watch --import tsx src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
